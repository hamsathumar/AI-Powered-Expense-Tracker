{
  "expo": {
    "name": "Kaasu",
    "slug": "kaasu",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kaasu",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.hamsath.kaasu",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Kaasu transcribes your voice on-device so you can see what it heard while you speak.",
        "NSMicrophoneUsageDescription": "Kaasu uses the microphone so you can log transactions by voice."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FBF6F1",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "package": "com.hamsath.kaasu"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF6F1",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76,
          "dark": {
            "backgroundColor": "#1A1614"
          }
        }
      ],
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      [
        "expo-audio",
        {
          "microphonePermission": "Kaasu uses the microphone so you can log transactions by voice."
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Kaasu uses your photo library so you can set a profile picture."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Kaasu uses the microphone so you can log transactions by voice.",
          "speechRecognitionPermission": "Kaasu transcribes your voice on-device so you can see what it heard while you speak."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
